# =========================
# Model artifacts
# =========================

# Ignore all model artifacts by default
models/*

# Keep the final model needed for dashboard inference
!models/fraud_model_pipeline.joblib

# =========================
# Reports
# =========================

# Ignore generated reports by default
reports/*

# Keep useful portfolio reports
!reports/training_report.json
!reports/.gitkeep

